font-family = JetBrains Mono
font-size = 11
mouse-hide-while-typing = true
scrollback-limit = 1000001
copy-on-select = false

# Ghostty leader: 不碰 ctrl+h/j/k/l，留給 nvim / plugin
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right

# tmux-like split
keybind = ctrl+a>minus=new_split:down
keybind = ctrl+a>shift+backslash=new_split:right

# zoom / equalize / close
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>equal=equalize_splits
keybind = ctrl+a>x=close_surface

# resize
#keybind = ctrl+a>shift+h=resize_split:left,20
#keybind = ctrl+a>shift+j=resize_split:down,20
#keybind = ctrl+a>shift+k=resize_split:up,20
#keybind = ctrl+a>shift+l=resize_split:right,20

# tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab
keybind = ctrl+a>1=goto_tab:1
keybind = ctrl+a>2=goto_tab:2
keybind = ctrl+a>3=goto_tab:3
keybind = ctrl+a>4=goto_tab:4
keybind = ctrl+a>o=toggle_tab_overview

# utility
keybind = super+r=reload_config
keybind = ctrl+a>f=toggle_fullscreen
keybind = ctrl+a>m=toggle_maximize
keybind = ctrl+a>space=toggle_command_palette

